  OUT_FOR_PROCEDURE
}

enum QueueEventType {
  START_CLINIC
  NEXT_PATIENT
  SELF_SERVICE_REINSERTION
  RETURN_TO_QUEUE
  STAFF_REINSERTION
  UNDO
  APPOINTMENT_CANCELLED
  QUEUE_CLOSED
  CLINIC_DAY_CANCELLED
}

enum QueueEventActorType {
  USER
  PATIENT
  SYSTEM
}

enum QueueEventAppointmentLinkRole {
  PRIMARY
  SECONDARY
}

enum WaitingPlacementType {
  ORDINARY
  RETURN_TO_QUEUE
  IM_HERE
  STAFF_REINSERT
}

enum ClinicDayCancellationReason {
  DOCTOR_UNAVAILABLE
  CLINIC_CLOSED
  EMERGENCY
