  @@index([practiceLocationId, serviceDate, mobileNumberHash, createdAt], map: "BookingRecoveryAttempt_scope_mobile_created_idx")
  @@index([status, expiresAt], map: "BookingRecoveryAttempt_status_expires_idx")
  @@index([candidateAppointmentId], map: "BookingRecoveryAttempt_candidate_idx")
  @@index([expiresAt], map: "BookingRecoveryAttempt_expires_idx")
}

