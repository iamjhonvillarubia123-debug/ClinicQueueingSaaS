model ClinicDayOperationalNotice {
  id String @id @default(uuid())
  clinicDayId        String
  practiceLocationId String
  serviceDate        DateTime @db.Date
  kind   ClinicDayOperationalNoticeKind
  status ClinicDayOperationalNoticeStatus @default(ACTIVE)
