  @@index([purchasedByUserId, createdAt], map: "SubscriptionPurchase_purchasedBy_created_idx")
  @@index([status, createdAt], map: "SubscriptionPurchase_status_created_idx")
}

model SubscriptionPayment {
  id String @id @default(uuid())

  subscriptionPurchaseId String

  provider                 String @db.VarChar(100)
  providerPaymentReference String @db.VarChar(200)
  amount                   Decimal @db.Decimal(18, 2)

  status SubscriptionPaymentStatus @default(PENDING)

  initiatedAt DateTime @db.Timestamptz(3)
  confirmedAt DateTime? @db.Timestamptz(3)
  failedAt    DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  subscriptionPurchase SubscriptionPurchase @relation(fields: [subscriptionPurchaseId], references: [id], onDelete: Restrict)

  @@unique([provider, providerPaymentReference], map: "SubscriptionPayment_provider_reference_key")
  @@index([subscriptionPurchaseId, createdAt], map: "SubscriptionPayment_purchase_created_idx")
  @@index([status, createdAt], map: "SubscriptionPayment_status_created_idx")
}

model CommandIdempotency {
  id String @id @default(uuid())

  idempotencyKey     String @db.VarChar(100)
  commandIdentityKey String @unique @db.VarChar(64)
  commandType        CommandType
  requestFingerprint String @db.VarChar(64)

  practiceLocationId String?
  serviceDate        DateTime? @db.Date
  appointmentId      String?
  bookingDraftId     String?
  bookingRecoveryAttemptId String?
  actorUserId        String?
  accountUserId      String?

  bookingGroupId                String?
  bookingGroupRecoveryAttemptId String?

  doctorFinancialAccountId String?

  resultAppointmentId              String?
  resultQueueEventId               String?
  resultBookingGroupId             String?
  resultBookingGroupAccessTokenId  String?
  resultAdministrativeAccountActionId String?

  completedAt DateTime @db.Timestamptz(3)
  expiresAt   DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  practiceLocation PracticeLocation? @relation("CommandIdempotencyPracticeLocation", fields: [practiceLocationId], references: [id], onDelete: Restrict)
  appointment      Appointment?      @relation("CommandIdempotencyAppointmentScope", fields: [appointmentId], references: [id], onDelete: SetNull)
  actorUser        User?             @relation("CommandIdempotencyActorUser", fields: [actorUserId], references: [id], onDelete: Restrict)
  accountUser      User?             @relation("CommandIdempotencyAccountUser", fields: [accountUserId], references: [id], onDelete: Restrict)

  bookingRecoveryAttempt BookingRecoveryAttempt? @relation("CommandIdempotencyBookingRecoveryAttempt", fields: [bookingRecoveryAttemptId], references: [id], onDelete: SetNull)
  bookingGroupScope BookingGroup? @relation("CommandIdempotencyBookingGroupScope", fields: [bookingGroupId], references: [id], onDelete: SetNull)
  bookingGroupRecoveryAttempt BookingGroupRecoveryAttempt? @relation("CommandIdempotencyBookingGroupRecoveryAttempt", fields: [bookingGroupRecoveryAttemptId], references: [id], onDelete: SetNull)

  resultAppointment Appointment? @relation("CommandIdempotencyResultAppointment", fields: [resultAppointmentId], references: [id], onDelete: SetNull)
  resultQueueEvent QueueEvent? @relation("CommandIdempotencyResultQueueEvent", fields: [resultQueueEventId], references: [id], onDelete: Restrict)
  resultBookingGroup BookingGroup? @relation("CommandIdempotencyResultBookingGroup", fields: [resultBookingGroupId], references: [id], onDelete: SetNull)
  resultBookingGroupAccessToken BookingGroupAccessToken? @relation("CommandIdempotencyResultBookingGroupAccessToken", fields: [resultBookingGroupAccessTokenId], references: [id], onDelete: SetNull)
  resultAdministrativeAccountAction AdministrativeAccountAction? @relation("CommandIdempotencyAdministrativeAccountActionResult", fields: [resultAdministrativeAccountActionId], references: [id], onDelete: Restrict)

  notificationOutboxes   NotificationOutbox[]        @relation("CommandIdempotencyNotificationOutboxes")
  applicationNotifications ApplicationNotification[] @relation("CommandIdempotencyApplicationNotifications")
  permanentClosureAudits AccountPermanentClosureAudit[] @relation("CommandIdempotencyPermanentClosureAudits")

  @@index([expiresAt], map: "CommandIdempotency_expires_idx")
  @@index([practiceLocationId, serviceDate], map: "CommandIdempotency_location_date_idx")
  @@index([appointmentId], map: "CommandIdempotency_appointment_idx")
  @@index([bookingDraftId], map: "CommandIdempotency_bookingDraft_idx")
  @@index([bookingRecoveryAttemptId], map: "CommandIdempotency_bookingRecovery_idx")
  @@index([actorUserId], map: "CommandIdempotency_actor_idx")
  @@index([accountUserId], map: "CommandIdempotency_account_idx")
  @@index([bookingGroupId], map: "CommandIdempotency_bookingGroup_idx")
  @@index([bookingGroupRecoveryAttemptId], map: "CommandIdempotency_groupRecovery_idx")
  @@index([doctorFinancialAccountId], map: "CommandIdempotency_financialAccount_idx")
  @@index([resultAppointmentId], map: "CommandIdempotency_resultAppointment_idx")
  @@index([resultQueueEventId], map: "CommandIdempotency_resultQueueEvent_idx")
  @@index([resultBookingGroupId], map: "CommandIdempotency_resultBookingGroup_idx")
  @@index([resultBookingGroupAccessTokenId], map: "CommandIdempotency_resultGroupToken_idx")
  @@index([resultAdministrativeAccountActionId], map: "CommandIdempotency_resultAdminAction_idx")
  doctorFinancialAccount DoctorFinancialAccount? @relation("CommandIdempotencyDoctorFinancialAccount", fields: [doctorFinancialAccountId], references: [id], onDelete: Restrict)
  subscriptionPurchases SubscriptionPurchase[] @relation("SubscriptionPurchaseCommandIdempotency")
}

model BookingDraft {
  id               String             @id @default(uuid())
  bookingReference String             @unique @db.VarChar(20)
  mode             BookingDraftMode   @default(INDIVIDUAL)
  status           BookingDraftStatus @default(PENDING_OTP)

  practiceLocationId String

  existingPatientResponse ExistingPatientResponse?

  firstName  String? @db.VarChar(100)
  middleName String? @db.VarChar(100)
  lastName   String? @db.VarChar(100)
  suffix     String? @db.VarChar(20)

  mobileNumberEncrypted String?
  mobileNumberHash      String? @db.VarChar(128)
  mobileNumberLastFour  String? @db.Char(4)

  serviceDate DateTime @db.Date

  estimatedServiceMinutes Int?

  expiresAt   DateTime  @db.Timestamptz(3)
  consumedAt  DateTime? @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  practiceLocation PracticeLocation @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)

  otpVerifications    OtpVerification[]
  bookingDraftMembers BookingDraftMember[]
  bookingDraftAnswers BookingDraftAnswer[]
  serviceSelections   BookingDraftServiceSelection[]

  @@index([practiceLocationId, serviceDate])
  @@index([mobileNumberHash, practiceLocationId, serviceDate, status])
  @@index([mode, status, expiresAt])
  @@index([status, expiresAt])
}

model BookingDraftMember {
  id String @id @default(uuid())

  bookingDraftId String
  memberOrder    Int

  firstName  String? @db.VarChar(100)
  middleName String? @db.VarChar(100)
  lastName   String? @db.VarChar(100)
  suffix     String? @db.VarChar(20)

  existingPatientResponse ExistingPatientResponse?
  estimatedServiceMinutes Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  bookingDraft BookingDraft @relation(fields: [bookingDraftId], references: [id], onDelete: Restrict)

  answers           BookingDraftAnswer[]
  serviceSelections BookingDraftServiceSelection[]

  @@unique([bookingDraftId, memberOrder])
  @@unique([id, bookingDraftId])
  @@index([bookingDraftId])
}

model BookingDraftServiceSelection {
  id String @id @default(uuid())

  bookingDraftId            String
  bookingDraftMemberId      String?
  practiceLocationServiceId String

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  bookingDraft            BookingDraft            @relation(fields: [bookingDraftId], references: [id], onDelete: Restrict)
  bookingDraftMember      BookingDraftMember?     @relation(fields: [bookingDraftMemberId, bookingDraftId], references: [id, bookingDraftId], onDelete: Restrict)
  practiceLocationService PracticeLocationService @relation(fields: [practiceLocationServiceId], references: [id], onDelete: Restrict)

  @@index([bookingDraftId])
  @@index([bookingDraftMemberId])
  @@index([practiceLocationServiceId])
}

model ClinicDay {
  id String @id @default(uuid())

  practiceLocationId String
  serviceDate        DateTime @db.Date

  status ClinicDayStatus @default(NOT_STARTED)

  openingOverrideAt           DateTime? @db.Timestamptz(3)
  delayedOpeningDeclaredAt    DateTime? @db.Timestamptz(3)
  maximumOnlineBookingUntilAt DateTime? @db.Timestamptz(3)

  operatingPracticeStaffId String?

  startedAt DateTime? @db.Timestamptz(3)
  closedAt  DateTime? @db.Timestamptz(3)

  cancelledAt        DateTime?                    @db.Timestamptz(3)
  cancelledByUserId  String?
  cancellationReason ClinicDayCancellationReason?
  cancellationNote   String?                      @db.VarChar(500)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  practiceLocation PracticeLocation @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)

  operatingPracticeStaff PracticeStaff? @relation("ClinicDayOperatingPracticeStaff", fields: [operatingPracticeStaffId], references: [id], onDelete: Restrict)

  cancelledByUser User? @relation("ClinicDayCancelledByUser", fields: [cancelledByUserId], references: [id], onDelete: Restrict)

  @@unique([practiceLocationId, serviceDate])
  @@index([status, serviceDate])
  @@index([operatingPracticeStaffId, serviceDate])
}

model QueueCounter {
  id                  String   @id @default(uuid())
  practiceLocationId  String
  serviceDate         DateTime @db.Date
  lastAllocatedNumber Int      @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  practiceLocation PracticeLocation @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)

  @@unique([practiceLocationId, serviceDate])
}

model QueueEvent {
  id String @id @default(uuid())

  practiceLocationId String
  serviceDate        DateTime @db.Date
  queueEventSequence BigInt

  type      QueueEventType
  actorType QueueEventActorType

  actorUserId String?

  previousPrimaryStatus   AppointmentStatus?
  newPrimaryStatus        AppointmentStatus?
  previousSecondaryStatus AppointmentStatus?
  newSecondaryStatus      AppointmentStatus?

  previousPrimaryOrderKey   Decimal? @db.Decimal(38, 18)
  newPrimaryOrderKey        Decimal? @db.Decimal(38, 18)
  previousSecondaryOrderKey Decimal? @db.Decimal(38, 18)
  newSecondaryOrderKey      Decimal? @db.Decimal(38, 18)

  previousPrimaryWaitingPlacementType   WaitingPlacementType?
  newPrimaryWaitingPlacementType        WaitingPlacementType?
  previousSecondaryWaitingPlacementType WaitingPlacementType?
  newSecondaryWaitingPlacementType      WaitingPlacementType?

  previousPrimaryTerminalAt   DateTime? @db.Timestamptz(3)
  newPrimaryTerminalAt        DateTime? @db.Timestamptz(3)
  previousSecondaryTerminalAt DateTime? @db.Timestamptz(3)
  newSecondaryTerminalAt      DateTime? @db.Timestamptz(3)

  previousPrimarySelfServiceReinsertedAt DateTime? @db.Timestamptz(3)
  newPrimarySelfServiceReinsertedAt      DateTime? @db.Timestamptz(3)

  clinicClosureDisposition ClinicClosureDisposition?

  reversesQueueEventId String? @unique

  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  practiceLocation PracticeLocation @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)
  actorUser        User?            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  appointmentLinks QueueEventAppointmentLink[]

  reversesQueueEvent   QueueEvent? @relation("QueueEventReversal", fields: [reversesQueueEventId], references: [id], onDelete: Restrict)
  reversedByQueueEvent QueueEvent? @relation("QueueEventReversal")

  @@unique([practiceLocationId, serviceDate, queueEventSequence], map: "QueueEvent_scope_sequence_key")
  @@index([practiceLocationId, serviceDate, queueEventSequence], map: "QueueEvent_scope_sequence_idx")
  @@index([practiceLocationId, serviceDate, createdAt])
  @@index([actorUserId, createdAt])
  @@index([type, createdAt])
  resultCommandIdempotencies CommandIdempotency[] @relation("CommandIdempotencyResultQueueEvent")
}

model QueueEventAppointmentLink {
  id String @id @default(uuid())

  queueEventId  String
  role          QueueEventAppointmentLinkRole
  appointmentId String

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  queueEvent  QueueEvent  @relation(fields: [queueEventId], references: [id], onDelete: Restrict)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([queueEventId, role])
  @@unique([queueEventId, appointmentId])
  @@index([appointmentId, createdAt])
  @@index([queueEventId])
}

model BookingQuestion {
  id                 String              @id @default(uuid())
  practiceLocationId String
  questionText       String              @db.VarChar(500)
  helpText           String?             @db.VarChar(500)
  type               BookingQuestionType
  isRequired         Boolean             @default(false)
  displayOrder       Int
  isActive           Boolean             @default(true)

  estimatedMinutesAdjustment Int @default(0)

  textMaximumLength Int?
  numberMinimum     Decimal?
  numberMaximum     Decimal?
  selectOptions     Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  practiceLocation    PracticeLocation                        @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)
  bookingDraftAnswers BookingDraftAnswer[]
  appointmentAnswers  AppointmentAnswer[]
  draftProposals      SecretarySettingsDraftBookingQuestion[]

  @@unique([practiceLocationId, displayOrder])
  @@index([practiceLocationId, isActive, displayOrder])
}

model BookingDraftAnswer {
  id                   String  @id @default(uuid())
  bookingDraftId       String
  bookingDraftMemberId String?
  bookingQuestionId    String

  answerText    String?
  answerNumber  Decimal?
  answerBoolean Boolean?

  selectedOptionValue String? @db.VarChar(100)

  estimatedMinutesAdjustment Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  bookingDraft       BookingDraft        @relation(fields: [bookingDraftId], references: [id], onDelete: Restrict)
  bookingDraftMember BookingDraftMember? @relation(fields: [bookingDraftMemberId, bookingDraftId], references: [id, bookingDraftId], onDelete: Restrict)
  bookingQuestion    BookingQuestion     @relation(fields: [bookingQuestionId], references: [id], onDelete: Restrict)

  @@index([bookingDraftId])
  @@index([bookingDraftMemberId])
  @@index([bookingQuestionId])
}

model AppointmentBookedService {
  id String @id @default(uuid())

  appointmentId             String
  practiceLocationServiceId String

  // Immutable confirmed-booking snapshots. Later Service edits or retirement
  // must not rewrite what this Appointment originally booked.
  serviceNameSnapshot     String @db.VarChar(150)
  durationMinutesSnapshot Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  appointment             Appointment             @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  practiceLocationService PracticeLocationService @relation(fields: [practiceLocationServiceId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, practiceLocationServiceId], map: "AppointmentBookedService_appointment_service_key")
  @@index([appointmentId], map: "AppointmentBookedService_appointmentId_idx")
  @@index([practiceLocationServiceId], map: "AppointmentBookedService_serviceId_idx")
}

model AppointmentAnswer {
  id                String @id @default(uuid())
  appointmentId     String
  bookingQuestionId String

  answerText    String?
  answerNumber  Decimal?
  answerBoolean Boolean?

  selectedOptionValue String? @db.VarChar(100)

  estimatedMinutesAdjustment Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  appointment     Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  bookingQuestion BookingQuestion @relation(fields: [bookingQuestionId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, bookingQuestionId])
  @@index([bookingQuestionId])
}
