model User {
  id         String  @id @default(uuid())
  email      String  @db.VarChar(255)
  firstName  String  @db.VarChar(100)
  middleName String? @db.VarChar(100)
  lastName   String  @db.VarChar(100)

  mobileNumber String @db.VarChar(30)
  passwordHash String @db.VarChar(255)

  role                            UserRole
  accountStatus                   UserAccountStatus               @default(ACTIVE)
  administrativeRestrictionStatus AdministrativeRestrictionStatus @default(NONE)

  emailVerifiedAt DateTime? @db.Timestamptz(3)
  lastLoginAt     DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  doctorProfile                    DoctorProfile?
  practiceStaffAssignments         PracticeStaff[]
  grantedPracticeStaffCapabilities PracticeStaffCapability[]            @relation("PracticeStaffCapabilityGrantedBy")
  revokedPracticeStaffCapabilities PracticeStaffCapability[]            @relation("PracticeStaffCapabilityRevokedBy")
  reviewedSecretarySettingsDrafts  SecretarySettingsDraft[]             @relation("SecretarySettingsDraftReviewedBy")
  createdAppointments              Appointment[]
  createdScheduledReminders        ScheduledReminder[]                 @relation("ScheduledReminderCreatedBy")
  editedScheduledReminders         ScheduledReminder[]                 @relation("ScheduledReminderLastEditedBy")
  queueEvents                      QueueEvent[]
  cancelledClinicDays              ClinicDay[]                          @relation("ClinicDayCancelledByUser")
  userSessions                     UserSession[]
  dataRetentionAcknowledgements    DoctorDataRetentionAcknowledgement[]

  permanentClosureAuditsAsAccount AccountPermanentClosureAudit[] @relation("AccountPermanentClosureAuditAccountUser")
  permanentClosureAuditsInitiated AccountPermanentClosureAudit[] @relation("AccountPermanentClosureAuditInitiator")

  administrativeActionsPerformed AdministrativeAccountAction[] @relation("AdministrativeAccountActionActor")
  administrativeActionsReceived  AdministrativeAccountAction[] @relation("AdministrativeAccountActionTargetDoctor")

  receivedApplicationNotifications           ApplicationNotification[] @relation("ApplicationNotificationRecipient")
  secretaryLifecycleApplicationNotifications ApplicationNotification[] @relation("ApplicationNotificationAffectedSecretary")
  commandIdempotenciesAsActor       CommandIdempotency[] @relation("CommandIdempotencyActorUser")
  commandIdempotenciesAsAccountUser CommandIdempotency[] @relation("CommandIdempotencyAccountUser")
  doctorFinancialAccount DoctorFinancialAccount?
  subscriptionPurchases SubscriptionPurchase[] @relation("SubscriptionPurchasePurchasedBy")
}

model DoctorProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  middleName         String?  @db.VarChar(100)
  suffix             String?  @db.VarChar(30)
  professionalTitle  String   @db.VarChar(50)
  specialization     String   @db.VarChar(150)
  licenseNumber      String   @unique @db.VarChar(100)
  profileDescription String?
  profilePhotoUrl    String?  @db.VarChar(500)
  publicSlug         String?  @unique @db.VarChar(120)
  isProfilePublic    Boolean  @default(false)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  practiceLocations        PracticeLocation[]
  serviceTemplates         DoctorServiceTemplate[]
  bookingQuestionTemplates DoctorBookingQuestionTemplate[]
  doctorCalendarRules      DoctorCalendarRule[]
  accountSettings          DoctorAccountSettings?
  user                     User                            @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model DoctorAccountSettings {
  id                         String   @id @default(uuid())
  doctorProfileId            String   @unique
  defaultTimeZone            String   @default("Asia/Manila") @db.VarChar(100)
  defaultConsultationMinutes Int      @default(30)
  maximumAdvanceBookingDays  Int      @default(30)
  allowOnlineBooking         Boolean  @default(true)
  noClinicOnRegularHolidays  Boolean  @default(false)
  createdAt                  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime @updatedAt @db.Timestamptz(3)

  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)
}

model UserSession {
  id String @id @default(uuid())

  userId    String
  tokenHash String @unique @db.VarChar(64)

  lastSeenAt    DateTime  @db.Timestamptz(3)
  idleExpiresAt DateTime  @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model DoctorDataRetentionAcknowledgement {
  id String @id @default(uuid())

  doctorUserId           String
  acknowledgementVersion String   @db.VarChar(50)
  acknowledgedAt         DateTime @db.Timestamptz(3)

  doctorUser User @relation(fields: [doctorUserId], references: [id], onDelete: Restrict)

  @@unique([doctorUserId, acknowledgementVersion])
  @@index([doctorUserId, acknowledgedAt])
}

model AccountPermanentClosureAudit {
  id                    String                      @id @default(uuid())
  accountUserId         String                      @unique
  initiatedByUserId     String
  closureType           AccountPermanentClosureType
  previousAccountStatus UserAccountStatus
  occurredAt            DateTime                    @default(now()) @db.Timestamptz(3)

  // Wired to CommandIdempotency when the canonical idempotency model is installed.
  commandIdempotencyId String?

  accountUser User @relation("AccountPermanentClosureAuditAccountUser", fields: [accountUserId], references: [id], onDelete: Restrict)

  initiatedByUser User @relation("AccountPermanentClosureAuditInitiator", fields: [initiatedByUserId], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@index([closureType, occurredAt])
  @@index([commandIdempotencyId])
  commandIdempotency CommandIdempotency? @relation("CommandIdempotencyPermanentClosureAudits", fields: [commandIdempotencyId], references: [id], onDelete: SetNull)
}

model AdministrativeAccountAction {
  id                 String                          @id @default(uuid())
  actionType         AdministrativeAccountActionType
  actorUserId        String
  targetDoctorUserId String

  reasonCategory AdministrativeReasonCategory?
  explanation    String?                       @db.VarChar(1000)
  resolutionText String?                       @db.VarChar(1000)

  restoresActionId String?  @unique
  occurredAt       DateTime @default(now()) @db.Timestamptz(3)

  actorUser User @relation("AdministrativeAccountActionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  targetDoctorUser User @relation("AdministrativeAccountActionTargetDoctor", fields: [targetDoctorUserId], references: [id], onDelete: Restrict)

  restoresAction AdministrativeAccountAction? @relation("AdministrativeAccountActionRestoration", fields: [restoresActionId], references: [id], onDelete: Restrict)

  restoredByAction AdministrativeAccountAction? @relation("AdministrativeAccountActionRestoration")

  scopes AdministrativeAccountActionScope[]

  @@index([targetDoctorUserId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([actionType, occurredAt])
  resultCommandIdempotencies CommandIdempotency[] @relation("CommandIdempotencyAdministrativeAccountActionResult")
}

model AdministrativeAccountActionScope {
  id                            String @id @default(uuid())
  administrativeAccountActionId String
  practiceLocationId            String

  // Wired to ClinicDay when the canonical ClinicDay model is installed.
  clinicDayId String?

  administrativeAccountAction AdministrativeAccountAction @relation(fields: [administrativeAccountActionId], references: [id], onDelete: Restrict)

  practiceLocation PracticeLocation @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)

  @@index([administrativeAccountActionId])
  @@index([practiceLocationId])
  @@index([clinicDayId])
}

model ApplicationNotification {
  id                      String                      @id @default(uuid())
  recipientUserId         String
  notificationType        ApplicationNotificationType
  affectedSecretaryUserId String?
  practiceLocationId      String?
  notificationIdentityKey String                      @unique @db.Char(64)

  // Wired to CommandIdempotency when the canonical idempotency model is installed.
  commandIdempotencyId String?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  readAt    DateTime? @db.Timestamptz(3)

  recipientUser User @relation("ApplicationNotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)

  affectedSecretaryUser User? @relation("ApplicationNotificationAffectedSecretary", fields: [affectedSecretaryUserId], references: [id], onDelete: Restrict)

  practiceLocation PracticeLocation? @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)

  @@index([recipientUserId, readAt])
  @@index([recipientUserId, createdAt])
  @@index([affectedSecretaryUserId])
  @@index([practiceLocationId])
  @@index([commandIdempotencyId])
  commandIdempotency CommandIdempotency? @relation("CommandIdempotencyApplicationNotifications", fields: [commandIdempotencyId], references: [id], onDelete: SetNull)
}

model PracticeLocation {
  id              String @id @default(uuid())
  doctorProfileId String

  // Phase 5 stable public-route identity. It is not an auth credential.
  publicIdentifier String @unique @default(uuid()) @db.VarChar(64)

  // Phase 3 lifecycle authority. Legacy PracticeLocation.isActive is removed.
  lifecycleStatus PracticeLocationLifecycleStatus @default(DRAFT)

  // Public online-booking control remains independent from lifecycle.
  isBookingEnabled Boolean @default(true)

  // DRAFT locations may be incomplete. Activation-time application validation
  // requires the effective fields needed for operation/public presentation.
  name             String? @db.VarChar(200)
  addressLine1     String? @db.VarChar(255)
  addressLine2     String? @db.VarChar(255)
  cityMunicipality String? @db.VarChar(120)
  province         String? @db.VarChar(120)
  postalCode       String? @db.VarChar(20)
  contactNumber    String? @db.VarChar(30)

  // Authoritative after configuration; DRAFT may still be incomplete.
  countryCode String? @db.Char(2)
  timeZone    String? @db.VarChar(100)

  // Exactly zero or one current regular Secretary assignment.
  currentRegularPracticeStaffId String? @unique

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)

  currentRegularPracticeStaff PracticeStaff? @relation("PracticeLocationCurrentRegularSecretary", fields: [currentRegularPracticeStaffId], references: [id], onDelete: Restrict)

  staffAssignments        PracticeStaff[]
  secretarySettingsDrafts SecretarySettingsDraft[]
  services                PracticeLocationService[]
  practiceSchedules       PracticeSchedule[]
  scheduleExceptions      ScheduleException[]

  bookingDrafts           BookingDraft[]
  appointments            Appointment[]
  bookingGroups           BookingGroup[]
  clinicDays              ClinicDay[]
  queueCounters           QueueCounter[]
  queueEvents             QueueEvent[]
  bookingQuestions        BookingQuestion[]
  bookingRecoveryAttempts BookingRecoveryAttempt[]
  bookingGroupRecoveryAttempts BookingGroupRecoveryAttempt[]
  scheduledReminders ScheduledReminder[]
  notificationOutboxes NotificationOutbox[]

  applicationNotifications          ApplicationNotification[]
  administrativeAccountActionScopes AdministrativeAccountActionScope[]

  @@index([doctorProfileId])
  @@index([lifecycleStatus])
  @@index([doctorProfileId, lifecycleStatus])
  commandIdempotencies CommandIdempotency[] @relation("CommandIdempotencyPracticeLocation")
}

model PracticeStaff {
  id                 String            @id @default(uuid())
  userId             String
  practiceLocationId String
  staffRole          PracticeStaffRole @default(SECRETARY)

  // Valid domain-specific assignment eligibility flag.
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  practiceLocation PracticeLocation @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)

  // Current regular-Secretary authority is held by PracticeLocation's
  // one-to-one pointer; historical PracticeStaff rows remain preserved.
  regularSecretaryFor PracticeLocation? @relation("PracticeLocationCurrentRegularSecretary")

  capabilities                    PracticeStaffCapability[]
  authoredSecretarySettingsDrafts SecretarySettingsDraft[]
  operatingClinicDays             ClinicDay[]               @relation("ClinicDayOperatingPracticeStaff")

  @@unique([userId, practiceLocationId])
  @@index([practiceLocationId, isActive])
  @@index([userId, isActive])
}

model PracticeStaffCapability {
  id String @id @default(uuid())

  practiceStaffId String

  capabilityType PracticeStaffCapabilityType
  status         PracticeStaffCapabilityStatus @default(ACTIVE)

  // Derived backend key representing the one currently active grant for the
  // assignment + capability type. Cleared on revocation.
  activeCapabilityKey String? @unique @db.VarChar(64)

  grantedByUserId String
  grantedAt       DateTime @db.Timestamptz(3)

  revokedByUserId String?
  revokedAt       DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  practiceStaff PracticeStaff @relation(fields: [practiceStaffId], references: [id], onDelete: Restrict)

  grantedByUser User @relation("PracticeStaffCapabilityGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)

  revokedByUser User? @relation("PracticeStaffCapabilityRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@index([practiceStaffId, status])
  @@index([grantedByUserId, grantedAt])
  @@index([revokedByUserId, revokedAt])
}

model SecretarySettingsDraft {
  id String @id @default(uuid())

  practiceLocationId    String
  authorPracticeStaffId String

  status SecretarySettingsDraftStatus @default(DRAFT)

  // Submission/review timestamps express the workflow boundary.
  // No expiry field exists because SUBMITTED drafts do not expire by age.
  submittedAt DateTime? @db.Timestamptz(3)
  reviewedAt  DateTime? @db.Timestamptz(3)

  // Doctor reviewer exists only after a Doctor decision.
  reviewedByUserId String?

  // Optional Doctor comment for REJECTED / RETURNED_FOR_REWORK.
  reviewComment String? @db.VarChar(1000)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  practiceLocation PracticeLocation @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)

  // Historical authorship remains attached to the original PracticeStaff row
  // even after current regular-Secretary replacement.
  authorPracticeStaff PracticeStaff @relation(fields: [authorPracticeStaffId], references: [id], onDelete: Restrict)

  reviewedByUser User? @relation("SecretarySettingsDraftReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  proposedServices           SecretarySettingsDraftService[]
  proposedPracticeSchedules  SecretarySettingsDraftPracticeSchedule[]
  proposedScheduleExceptions SecretarySettingsDraftScheduleException[]
  proposedBookingQuestions   SecretarySettingsDraftBookingQuestion[]

  @@index([practiceLocationId, status])
  @@index([authorPracticeStaffId, status])
  @@index([reviewedByUserId, reviewedAt])
  @@index([submittedAt])
}

model DoctorServiceTemplate {
  id String @id @default(uuid())

  doctorProfileId String

  name            String                    @db.VarChar(150)
  durationMinutes Int
  status          ServiceAvailabilityStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)

  @@index([doctorProfileId, status])
  @@index([doctorProfileId, name])
}

model PracticeLocationService {
  id String @id @default(uuid())

  practiceLocationId String

  // Optional provenance only. Once copied, this location Service is fully
  // independent and never synchronizes back to the Doctor-wide template.
  sourceDoctorServiceTemplateId String?

  name            String                    @db.VarChar(150)
  durationMinutes Int
  status          ServiceAvailabilityStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  practiceLocation PracticeLocation @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)

  // No FK is intentionally used for sourceDoctorServiceTemplateId.
  // Template deletion/retirement must never block or mutate copied location
  // Services. Provenance is informational only.

  draftProposals            SecretarySettingsDraftService[]
  bookingDraftSelections    BookingDraftServiceSelection[]
  appointmentBookedServices AppointmentBookedService[]

  @@index([practiceLocationId, status])
  @@index([practiceLocationId, name])
  @@index([sourceDoctorServiceTemplateId])
}

model SecretarySettingsDraftService {
  id String @id @default(uuid())

  secretarySettingsDraftId String

  // Existing effective Service being proposed for edit/deactivation.
  // NULL means the proposal creates a new location-only/copied Service.
  practiceLocationServiceId String?

  // Optional Doctor template selected as the copy source for a proposed
  // location Service. It is provenance only, not synchronization authority.
  sourceDoctorServiceTemplateId String?

  proposedName            String                    @db.VarChar(150)
  proposedDurationMinutes Int
  proposedStatus          ServiceAvailabilityStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  secretarySettingsDraft  SecretarySettingsDraft   @relation(fields: [secretarySettingsDraftId], references: [id], onDelete: Restrict)
  practiceLocationService PracticeLocationService? @relation(fields: [practiceLocationServiceId], references: [id], onDelete: Restrict)

  @@index([secretarySettingsDraftId])
  @@index([practiceLocationServiceId])
  @@index([sourceDoctorServiceTemplateId])
}

model PracticeSchedule {
  id String @id @default(uuid())

  practiceLocationId String
  weekday            Weekday

  isOpen Boolean @default(false)

  // Local wall-clock values interpreted only through PracticeLocation.timeZone.
  opensAtLocal  DateTime? @db.Time(0)
  closesAtLocal DateTime? @db.Time(0)

  // Optional additional public automated-admission cutoff.
  // NULL means no separate cutoff at this layer.
  maximumOnlineBookingUntilLocal DateTime? @db.Time(0)

  // Independent workload/capacity ceiling for the Service Date.
  // It is not clinic closing time and may differ from closesAtLocal.
  maximumOperatingUntilLocal DateTime? @db.Time(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  practiceLocation PracticeLocation @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)

  @@unique([practiceLocationId, weekday])
