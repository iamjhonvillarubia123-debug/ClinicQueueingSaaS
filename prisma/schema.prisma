model User {
  id             String  @id @default(uuid()) @db.Uuid
  firstName      String  @db.VarChar(100)
  middleName     String? @db.VarChar(100)
  lastName       String  @db.VarChar(100)
  email          String  @db.VarChar(255)
  mobileNumber   String  @db.VarChar(30)
  passwordHash   String  @db.VarChar(255)
  role           UserRole
  accountStatus  UserAccountStatus @default(ACTIVE)
  administrativeRestrictionStatus AdministrativeRestrictionStatus @default(NONE)
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  lastLoginAt     DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  doctorProfile          DoctorProfile?
  staffAssignments       PracticeStaff[]
  createdAppointments    Appointment[] @relation("AppointmentCreatedBy")
  queueEvents             QueueEvent[] @relation("QueueEventActor")
  scheduledReminders      ScheduledReminder[] @relation("ScheduledReminderCreatedBy")
  clinicDayCancellations  ClinicDay[] @relation("ClinicDayCancelledBy")
  operatingStaffAudits    ClinicDayOperatingStaffAudit[] @relation("ClinicDayOperatingStaffAuditActor")
  userSessions            UserSession[]
  passwordResets          PasswordReset[]
  emailVerifications      EmailVerification[]
  administrativeActionsPerformed AdministrativeAccountAction[] @relation("AdministrativeAccountActionActor")
  administrativeActionsTargeted AdministrativeAccountAction[] @relation("AdministrativeAccountActionTarget")
  applicationNotificationsReceived ApplicationNotification[] @relation("ApplicationNotificationRecipient")
  applicationNotificationsAsSecretary ApplicationNotification[] @relation("ApplicationNotificationSecretary")
  accountPermanentClosureAudit AccountPermanentClosureAudit?
  financialAccessChallenges FinancialAccessChallenge[]
}

model DoctorProfile {
  id                   String  @id @default(uuid()) @db.Uuid
  userId               String  @unique @db.Uuid
  middleName           String? @db.VarChar(100)
  suffix               String? @db.VarChar(30)
  professionalTitle    String  @db.VarChar(50)
  specialization       String  @db.VarChar(150)
  licenseNumber        String  @unique @db.VarChar(100)
  isProfilePublic      Boolean @default(false)
  publicIdentifier     String  @unique @db.VarChar(64)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  user                  User @relation(fields: [userId], references: [id], onDelete: Restrict)
  accountSettings       DoctorAccountSettings?
  practiceLocations     PracticeLocation[]
  doctorServiceTemplates DoctorServiceTemplate[]
  doctorBookingQuestionTemplates DoctorBookingQuestionTemplate[]
  doctorCalendarRules   DoctorCalendarRule[]
  dataRetentionAcknowledgements DoctorDataRetentionAcknowledgement[]
  subscriptionEntitlement SubscriptionEntitlement?
  subscriptionPurchases SubscriptionPurchase[]
  subscriptionRefundRequests SubscriptionRefundRequest[]
}

model DoctorAccountSettings {
  id                                  String  @id @default(uuid()) @db.Uuid
