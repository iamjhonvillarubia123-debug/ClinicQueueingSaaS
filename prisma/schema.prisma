  endedByUser   User? @relation("ClinicDayOperationalNoticeEndedBy", fields: [endedByUserId], references: [id], onDelete: Restrict)

  @@index([practiceLocationId, serviceDate, status])
  @@index([clinicDayId, createdAt])
}

model ClinicDayOperatingStaffAudit {
  id String @id @default(uuid())
  clinicDayId        String
  practiceLocationId String
