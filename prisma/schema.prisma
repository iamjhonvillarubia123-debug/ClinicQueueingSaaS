// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PracticeStaffRole {
  SECRETARY
}

enum AppointmentStatus {
  WAITING
  CALLED
  TEMPORARILY_ABSENT
  OUT_FOR_PROCEDURE
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum AppointmentCancelledByType {
  PATIENT
  DOCTOR
  SECRETARY
  SYSTEM
}

enum OtpPurpose {
  BOOKING_VERIFICATION
}

enum BookingAccessTokenPurpose {
  VIEW_AND_MANAGE_BOOKING
  VIEW_ONLY
}

enum FollowUpRecommendationStatus {
  SCHEDULED
  SENT
  CANCELLED
  FAILED
  EXPIRED
}

enum NotificationType {
  OTP
  BOOKING_CONFIRMED
  APPOINTMENT_REMINDER
  FOLLOW_UP_REMINDER
  CANCELLATION_CONFIRMATION
}

enum NotificationChannel {
  SMS
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum UserRole {
  DOCTOR
  SECRETARY
  SYSTEM_ADMIN
}

enum UserAccountStatus {
  ACTIVE
  VOLUNTARILY_DISABLED
  PERMANENTLY_CLOSED
}

enum AdministrativeRestrictionStatus {
  NONE
  SUSPENDED
  EMERGENCY_SUSPENDED
}

enum AccountPermanentClosureType {
  DOCTOR_PERMANENT_CLOSURE
  SECRETARY_PERMANENT_CLOSURE
}

enum AdministrativeAccountActionType {
  NORMAL_SUSPENSION
  NORMAL_RESTORATION
  EMERGENCY_SUSPENSION
  EMERGENCY_RESTORATION
}

enum AdministrativeReasonCategory {
  SECURITY_CONCERN
  SUSPECTED_FRAUD_OR_ABUSE
  SERIOUS_POLICY_VIOLATION
  ACCOUNT_COMPROMISE
  LEGAL_REQUIREMENT
  REGULATORY_REQUIREMENT
  SERIOUS_PLATFORM_SAFETY
}

enum ApplicationNotificationType {
  SECRETARY_ACCOUNT_DISABLED
  SECRETARY_ACCOUNT_DELETED
}

enum BookingDraftStatus {
  PENDING_OTP
  CONSUMED
  EXPIRED
  CANCELLED
}

enum ExistingPatientResponse {
  YES
  NO
  UNSURE
}

enum QueueEventType {
  NEXT_PATIENT
  SELF_SERVICE_REINSERTION
  STAFF_REINSERTION
  OUT_FOR_PROCEDURE
  UNDO_NEXT_PATIENT
  APPOINTMENT_CANCELLED
  QUEUE_CLOSED
}

enum QueueEventActorType {
  USER
  PATIENT
  SYSTEM
}

enum BookingQuestionType {
  TEXT
  NUMBER
  BOOLEAN
  SINGLE_SELECT
}

model User {
  id         String  @id @default(uuid())
  email      String  @db.VarChar(255)
  firstName  String  @db.VarChar(100)
  middleName String? @db.VarChar(100)
  lastName   String  @db.VarChar(100)

  mobileNumber String @db.VarChar(30)
  passwordHash String @db.VarChar(255)

  role                            UserRole
  accountStatus                   UserAccountStatus               @default(ACTIVE)
  administrativeRestrictionStatus AdministrativeRestrictionStatus @default(NONE)

  emailVerifiedAt DateTime? @db.Timestamptz(3)
  lastLoginAt     DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  doctorProfile                 DoctorProfile?
  practiceStaffAssignments      PracticeStaff[]
  createdAppointments           Appointment[]
  followUpRecommendations       FollowUpRecommendation[]
  queueEvents                   QueueEvent[]
  userSessions                  UserSession[]
  dataRetentionAcknowledgements DoctorDataRetentionAcknowledgement[]

  permanentClosureAuditsAsAccount AccountPermanentClosureAudit[] @relation("AccountPermanentClosureAuditAccountUser")
  permanentClosureAuditsInitiated AccountPermanentClosureAudit[] @relation("AccountPermanentClosureAuditInitiator")

  administrativeActionsPerformed AdministrativeAccountAction[] @relation("AdministrativeAccountActionActor")
  administrativeActionsReceived  AdministrativeAccountAction[] @relation("AdministrativeAccountActionTargetDoctor")

  receivedApplicationNotifications           ApplicationNotification[] @relation("ApplicationNotificationRecipient")
  secretaryLifecycleApplicationNotifications ApplicationNotification[] @relation("ApplicationNotificationAffectedSecretary")

  @@index([email])
}

model DoctorProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  middleName         String?  @db.VarChar(100)
  suffix             String?  @db.VarChar(30)
  professionalTitle  String   @db.VarChar(50)
  specialization     String   @db.VarChar(150)
  licenseNumber      String   @unique @db.VarChar(100)
  profileDescription String?
  profilePhotoUrl    String?  @db.VarChar(500)
  publicSlug         String?  @unique @db.VarChar(120)
  isProfilePublic    Boolean  @default(false)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  practiceLocations PracticeLocation[]
  accountSettings   DoctorAccountSettings?
  user              User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model DoctorAccountSettings {
  id                         String   @id @default(uuid())
  doctorProfileId            String   @unique
  defaultTimeZone            String   @default("Asia/Manila") @db.VarChar(100)
  defaultConsultationMinutes Int      @default(30)
  maximumAdvanceBookingDays  Int      @default(30)
  allowOnlineBooking         Boolean  @default(true)
  createdAt                  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime @updatedAt @db.Timestamptz(3)

  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)
}

model UserSession {
  id String @id @default(uuid())

  userId    String
  tokenHash String @unique @db.VarChar(64)

  lastSeenAt    DateTime  @db.Timestamptz(3)
  idleExpiresAt DateTime  @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model DoctorDataRetentionAcknowledgement {
  id String @id @default(uuid())

  doctorUserId           String
  acknowledgementVersion String   @db.VarChar(50)
  acknowledgedAt         DateTime @db.Timestamptz(3)

  doctorUser User @relation(fields: [doctorUserId], references: [id], onDelete: Restrict)

  @@unique([doctorUserId, acknowledgementVersion])
  @@index([doctorUserId, acknowledgedAt])
}

model AccountPermanentClosureAudit {
  id                    String                      @id @default(uuid())
  accountUserId         String                      @unique
  initiatedByUserId     String
  closureType           AccountPermanentClosureType
  previousAccountStatus UserAccountStatus
  occurredAt            DateTime                    @default(now()) @db.Timestamptz(3)

  // Wired to CommandIdempotency when the canonical idempotency model is installed.
  commandIdempotencyId String?

  accountUser User @relation("AccountPermanentClosureAuditAccountUser", fields: [accountUserId], references: [id], onDelete: Restrict)

  initiatedByUser User @relation("AccountPermanentClosureAuditInitiator", fields: [initiatedByUserId], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@index([closureType, occurredAt])
  @@index([commandIdempotencyId])
}

model AdministrativeAccountAction {
  id                 String                          @id @default(uuid())
  actionType         AdministrativeAccountActionType
  actorUserId        String
  targetDoctorUserId String

  reasonCategory AdministrativeReasonCategory?
  explanation    String?                       @db.VarChar(1000)
  resolutionText String?                       @db.VarChar(1000)

  restoresActionId String?  @unique
  occurredAt       DateTime @default(now()) @db.Timestamptz(3)

  actorUser User @relation("AdministrativeAccountActionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  targetDoctorUser User @relation("AdministrativeAccountActionTargetDoctor", fields: [targetDoctorUserId], references: [id], onDelete: Restrict)

  restoresAction AdministrativeAccountAction? @relation("AdministrativeAccountActionRestoration", fields: [restoresActionId], references: [id], onDelete: Restrict)

  restoredByAction AdministrativeAccountAction? @relation("AdministrativeAccountActionRestoration")

  scopes AdministrativeAccountActionScope[]

  @@index([targetDoctorUserId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([actionType, occurredAt])
}

model AdministrativeAccountActionScope {
  id                            String @id @default(uuid())
  administrativeAccountActionId String
  practiceLocationId            String

  // Wired to ClinicDay when the canonical ClinicDay model is installed.
  clinicDayId String?

  administrativeAccountAction AdministrativeAccountAction @relation(fields: [administrativeAccountActionId], references: [id], onDelete: Restrict)

  practiceLocation PracticeLocation @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)

  @@index([administrativeAccountActionId])
  @@index([practiceLocationId])
  @@index([clinicDayId])
}

model ApplicationNotification {
  id                      String                      @id @default(uuid())
  recipientUserId         String
  notificationType        ApplicationNotificationType
  affectedSecretaryUserId String?
  practiceLocationId      String?
  notificationIdentityKey String                      @unique @db.Char(64)

  // Wired to CommandIdempotency when the canonical idempotency model is installed.
  commandIdempotencyId String?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  readAt    DateTime? @db.Timestamptz(3)

  recipientUser User @relation("ApplicationNotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)

  affectedSecretaryUser User? @relation("ApplicationNotificationAffectedSecretary", fields: [affectedSecretaryUserId], references: [id], onDelete: Restrict)

  practiceLocation PracticeLocation? @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)

  @@index([recipientUserId, readAt])
  @@index([recipientUserId, createdAt])
  @@index([affectedSecretaryUserId])
  @@index([practiceLocationId])
  @@index([commandIdempotencyId])
}

model PracticeLocation {
  id               String   @id @default(uuid())
  doctorProfileId  String
  name             String   @db.VarChar(200)
  addressLine1     String   @db.VarChar(255)
  addressLine2     String?  @db.VarChar(255)
  cityMunicipality String   @db.VarChar(120)
  province         String   @db.VarChar(120)
  postalCode       String?  @db.VarChar(20)
  contactNumber    String   @db.VarChar(30)
  isActive         Boolean  @default(true)
  isBookingEnabled Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  doctorProfile                     DoctorProfile                      @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)
  staffAssignments                  PracticeStaff[]
  bookingDrafts                     BookingDraft[]
  appointments                      Appointment[]
  queueCounters                     QueueCounter[]
  queueEvents                       QueueEvent[]
  bookingQuestions                  BookingQuestion[]
  applicationNotifications          ApplicationNotification[]
  administrativeAccountActionScopes AdministrativeAccountActionScope[]

  @@index([doctorProfileId])
}

model PracticeStaff {
  id                 String            @id @default(uuid())
  userId             String
  practiceLocationId String
  staffRole          PracticeStaffRole @default(SECRETARY)
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)

  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  practiceLocation PracticeLocation @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)

  @@unique([userId, practiceLocationId])
  @@index([userId])
  @@index([practiceLocationId])
}

model Patient {
  id                    String    @id @default(uuid())
  fullName              String    @db.VarChar(150)
  mobileNumberEncrypted String
  mobileNumberHash      String    @unique @db.VarChar(128)
  mobileVerifiedAt      DateTime? @db.Timestamptz(3)
  isActive              Boolean   @default(true)
  anonymizedAt          DateTime? @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  appointments Appointment[]
}

model Appointment {
  id               String @id @default(uuid())
  bookingReference String @unique @db.VarChar(20)

  patientId          String
  patient            Patient          @relation(fields: [patientId], references: [id])
  practiceLocationId String
  practiceLocation   PracticeLocation @relation(fields: [practiceLocationId], references: [id])

  serviceDate             DateTime @db.Date
  estimatedServiceMinutes Int
  queueNumber             Int

  status AppointmentStatus @default(WAITING)

  arrivedAt          DateTime? @db.Timestamptz(3)
  calledAt           DateTime? @db.Timestamptz(3)
  serviceStartedAt   DateTime? @db.Timestamptz(3)
  serviceCompletedAt DateTime? @db.Timestamptz(3)

  cancelledAt        DateTime?                   @db.Timestamptz(3)
  cancelledByType    AppointmentCancelledByType?
  cancellationReason String?                     @db.VarChar(255)

  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id])

  anonymizedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  bookingAccessTokens     BookingAccessToken[]
  contactPreference       ContactPreference?
  followUpRecommendations FollowUpRecommendation[]
  notificationLogs        NotificationLog[]
  primaryQueueEvents      QueueEvent[]             @relation("PrimaryQueueEventAppointment")
  secondaryQueueEvents    QueueEvent[]             @relation("SecondaryQueueEventAppointment")
  appointmentAnswers      AppointmentAnswer[]

  @@unique([practiceLocationId, serviceDate, queueNumber])
  @@index([practiceLocationId, serviceDate])
  @@index([practiceLocationId, status, serviceDate])
  @@index([patientId])
  @@index([status])
}

model OtpVerification {
  id String @id @default(uuid())

  bookingDraftId String
  bookingDraft   BookingDraft @relation(fields: [bookingDraftId], references: [id], onDelete: Restrict)

  mobileNumberHash String     @db.VarChar(128)
  otpHash          String     @db.VarChar(255)
  purpose          OtpPurpose

  expiresAt DateTime @db.Timestamptz(3)

  attemptCount Int @default(0)
  maxAttempts  Int @default(5)

  verifiedAt    DateTime? @db.Timestamptz(3)
  consumedAt    DateTime? @db.Timestamptz(3)
  invalidatedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([bookingDraftId])
  @@index([mobileNumberHash, purpose, expiresAt])
  @@index([expiresAt])
}

model BookingAccessToken {
  id String @id @default(uuid())

  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  tokenHash String @unique @db.VarChar(255)

  purpose BookingAccessTokenPurpose @default(VIEW_AND_MANAGE_BOOKING)

  expiresAt DateTime @db.Timestamptz(3)

  lastUsedAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([appointmentId])
  @@index([expiresAt])
}

model ContactPreference {
  id String @id @default(uuid())

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  allowOperationalMessages Boolean @default(true)
  allowFollowUpReminder    Boolean @default(false)
  allowMarketingMessages   Boolean @default(false)

  acknowledgedAt DateTime  @db.Timestamptz(3)
  withdrawnAt    DateTime? @db.Timestamptz(3)

  privacyNoticeVersion String @db.VarChar(30)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

model FollowUpRecommendation {
  id String @id @default(uuid())

  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  recommendedByUserId String
  recommendedByUser   User   @relation(fields: [recommendedByUserId], references: [id], onDelete: Restrict)

  recommendedFollowUpDate DateTime @db.Date
  reminderScheduledAt     DateTime @db.Timestamptz(3)

  status FollowUpRecommendationStatus @default(SCHEDULED)

  shortNote String? @db.VarChar(150)

  sentAt      DateTime? @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  notificationLogs NotificationLog[]

  @@index([appointmentId])
  @@index([status, reminderScheduledAt])
  @@index([recommendedByUserId])
}

model NotificationLog {
  id String @id @default(uuid())

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  followUpRecommendationId String?
  followUpRecommendation   FollowUpRecommendation? @relation(fields: [followUpRecommendationId], references: [id])

  type    NotificationType
  channel NotificationChannel

  recipientMobileEncrypted String

  status NotificationStatus @default(PENDING)

  providerMessageId String? @db.VarChar(150)

  sentAt      DateTime? @db.Timestamptz(3)
  deliveredAt DateTime? @db.Timestamptz(3)
  failedAt    DateTime? @db.Timestamptz(3)

  failureReason String? @db.VarChar(255)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([appointmentId])
  @@index([status, createdAt])
  @@index([providerMessageId])
}

model BookingDraft {
  id               String             @id @default(uuid())
  bookingReference String             @unique @db.VarChar(20)
  status           BookingDraftStatus @default(PENDING_OTP)

  practiceLocationId      String
  existingPatientResponse ExistingPatientResponse

  firstName  String  @db.VarChar(100)
  middleName String? @db.VarChar(100)
  lastName   String  @db.VarChar(100)
  suffix     String? @db.VarChar(20)

  mobileNumberEncrypted String
  mobileNumberHash      String @db.VarChar(128)
  mobileNumberLastFour  String @db.Char(4)

  serviceDate             DateTime @db.Date
  estimatedServiceMinutes Int

  expiresAt   DateTime  @db.Timestamptz(3)
  consumedAt  DateTime? @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  practiceLocation    PracticeLocation     @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)
  otpVerifications    OtpVerification[]
  bookingDraftAnswers BookingDraftAnswer[]

  @@index([practiceLocationId, serviceDate])
  @@index([mobileNumberHash, expiresAt])
  @@index([expiresAt])
}

model QueueCounter {
  id                  String   @id @default(uuid())
  practiceLocationId  String
  serviceDate         DateTime @db.Date
  lastAllocatedNumber Int      @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  practiceLocation PracticeLocation @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)

  @@unique([practiceLocationId, serviceDate])
}

model QueueEvent {
  id String @id @default(uuid())

  practiceLocationId String
  serviceDate        DateTime @db.Date

  type      QueueEventType
  actorType QueueEventActorType

  actorUserId String?

  primaryAppointmentId   String
  secondaryAppointmentId String?

  previousPrimaryStatus   AppointmentStatus?
  newPrimaryStatus        AppointmentStatus?
  previousSecondaryStatus AppointmentStatus?
  newSecondaryStatus      AppointmentStatus?

  reversedEventId String? @unique

  isUndoable Boolean   @default(false)
  undoneAt   DateTime? @db.Timestamptz(3)

  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  practiceLocation     PracticeLocation @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)
  actorUser            User?            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  primaryAppointment   Appointment      @relation("PrimaryQueueEventAppointment", fields: [primaryAppointmentId], references: [id], onDelete: Restrict)
  secondaryAppointment Appointment?     @relation("SecondaryQueueEventAppointment", fields: [secondaryAppointmentId], references: [id], onDelete: Restrict)
  reversedEvent        QueueEvent?      @relation("QueueEventReversal", fields: [reversedEventId], references: [id], onDelete: Restrict)
  reversalEvent        QueueEvent?      @relation("QueueEventReversal")

  @@index([practiceLocationId, serviceDate, createdAt])
  @@index([primaryAppointmentId, createdAt])
  @@index([secondaryAppointmentId])
  @@index([actorUserId, createdAt])
  @@index([type, createdAt])
  @@index([isUndoable, practiceLocationId, serviceDate])
}

model BookingQuestion {
  id                 String              @id @default(uuid())
  practiceLocationId String
  questionText       String              @db.VarChar(500)
  helpText           String?             @db.VarChar(500)
  type               BookingQuestionType
  isRequired         Boolean             @default(false)
  displayOrder       Int
  isActive           Boolean             @default(true)

  estimatedMinutesAdjustment Int @default(0)

  textMaximumLength Int?
  numberMinimum     Decimal?
  numberMaximum     Decimal?
  selectOptions     Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  practiceLocation    PracticeLocation     @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)
  bookingDraftAnswers BookingDraftAnswer[]
  appointmentAnswers  AppointmentAnswer[]

  @@unique([practiceLocationId, displayOrder])
  @@index([practiceLocationId, isActive, displayOrder])
}

model BookingDraftAnswer {
  id                String @id @default(uuid())
  bookingDraftId    String
  bookingQuestionId String

  answerText    String?
  answerNumber  Decimal?
  answerBoolean Boolean?

  selectedOptionValue String? @db.VarChar(100)

  estimatedMinutesAdjustment Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  bookingDraft    BookingDraft    @relation(fields: [bookingDraftId], references: [id], onDelete: Restrict)
  bookingQuestion BookingQuestion @relation(fields: [bookingQuestionId], references: [id], onDelete: Restrict)

  @@unique([bookingDraftId, bookingQuestionId])
  @@index([bookingQuestionId])
}

model AppointmentAnswer {
  id                String @id @default(uuid())
  appointmentId     String
  bookingQuestionId String

  answerText    String?
  answerNumber  Decimal?
  answerBoolean Boolean?

  selectedOptionValue String? @db.VarChar(100)

  estimatedMinutesAdjustment Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  appointment     Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  bookingQuestion BookingQuestion @relation(fields: [bookingQuestionId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, bookingQuestionId])
  @@index([bookingQuestionId])
}
