  endedByUserId   String?
  activeNoticeKey String? @unique @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  clinicDay        ClinicDay        @relation(fields: [clinicDayId], references: [id], onDelete: Restrict)
