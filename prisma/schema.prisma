model User {
  id                              String                          @id @default(uuid())
  email                           String                          @unique
  firstName                       String
  lastName                        String
  mobileNumber                    String
  passwordHash                    String
  role                            UserRole
  accountStatus                   UserAccountStatus               @default(ACTIVE)
  administrativeRestrictionStatus AdministrativeRestrictionStatus @default(NONE)
  emailVerifiedAt                 DateTime?
  createdAt                       DateTime                        @default(now())
  updatedAt                       DateTime                        @updatedAt

  doctorProfile                         DoctorProfile?
  practiceStaffAssignments              PracticeStaff[]
  doctorFinancialAccount                DoctorFinancialAccount?
  secretaryInvitationsSent              SecretaryInvitation[]               @relation("SecretaryInvitationInviter")
  secretaryInvitationsReceived          SecretaryInvitation[]               @relation("SecretaryInvitationInvitee")
  administrativeActionsAsTarget         AdministrativeAccountAction[]       @relation("AdministrativeAccountActionTarget")
  administrativeActionsAsActor          AdministrativeAccountAction[]       @relation("AdministrativeAccountActionActor")
  systemAdminActionsAsTarget             SystemAdminAction[]                  @relation("SystemAdminActionTarget")
  systemAdminActionsAsActor              SystemAdminAction[]                  @relation("SystemAdminActionActor")
  clinicDaysOperating                    ClinicDay[]                          @relation("ClinicDayOperatingPracticeStaff")
  clinicDayOperatingStaffChangesAsActor  ClinicDayOperatingStaffChange[]     @relation("ClinicDayOperatingStaffChangeActor")
  clinicDaysCancelled                    ClinicDay[]                          @relation("ClinicDayCancelledBy")
  practiceStaffCapabilitiesGrantedBy     PracticeStaffCapability[]           @relation("PracticeStaffCapabilityGrantedBy")
  practiceStaffCapabilitiesRevokedBy     PracticeStaffCapability[]           @relation("PracticeStaffCapabilityRevokedBy")
  queueEvents                            QueueEvent[]
  commandIdempotencies                   CommandIdempotency[]
  notificationLogs                       NotificationLog[]
}

model DoctorProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  professionalTitle    String?
  specialization       String?
  licenseNumber        String   @unique
  publicSlug           String?  @unique
  defaultEstimatedMinutes Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  practiceLocations    PracticeLocation[]
}

model PracticeLocation {
  id                   String                          @id @default(uuid())
  doctorProfileId      String
  lifecycleStatus      PracticeLocationLifecycleStatus @default(DRAFT)
  name                 String
  countryCode          String
  timeZone             String
  addressLine1         String?
  addressLine2         String?
  city                 String?
  provinceState        String?
  postalCode           String?
  phoneNumber          String?
  instructions         String?
  maxOperatingTime     String?
  defaultEstimatedMinutes Int?
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt

  doctorProfile             DoctorProfile                     @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)
  practiceStaff             PracticeStaff[]
  services                  PracticeLocationService[]
  scheduleRules             PracticeLocationScheduleRule[]
  scheduleExceptions        PracticeLocationScheduleException[]
  bookingQuestions          BookingQuestion[]
  appointments              Appointment[]
  bookingDrafts             BookingDraft[]
  bookingGroups             BookingGroup[]
  queueEvents               QueueEvent[]
  clinicDays                ClinicDay[]
  queueCounter              QueueCounter?
  commandIdempotencies      CommandIdempotency[]
  notificationOutbox        NotificationOutbox[]
  notificationLogs          NotificationLog[]
  scheduledReminders        ScheduledReminder[]
  administrativeActionScopes AdministrativeAccountActionScope[]
  practiceStaffCapabilities PracticeStaffCapability[]
  secretarySettingsDrafts   SecretarySettingsDraft[]

  @@index([doctorProfileId])
}

model PracticeStaff {
  id                 String            @id @default(uuid())
  userId             String
  practiceLocationId String
  staffRole          PracticeStaffRole @default(SECRETARY)
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user                       User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  practiceLocation           PracticeLocation          @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)
  operatingClinicDays        ClinicDay[]               @relation("ClinicDayOperatingPracticeStaff")
  operatingStaffChangesFrom  ClinicDayOperatingStaffChange[] @relation("ClinicDayOperatingStaffChangePrevious")
  operatingStaffChangesTo    ClinicDayOperatingStaffChange[] @relation("ClinicDayOperatingStaffChangeNew")
  capabilities               PracticeStaffCapability[]

  @@unique([userId, practiceLocationId])
  @@index([practiceLocationId])
}

model PracticeStaffCapability {
  id                   String                        @id @default(uuid())
  practiceStaffId      String
  practiceLocationId   String
  capabilityType       PracticeStaffCapabilityType
  status               PracticeStaffCapabilityStatus @default(ACTIVE)
  grantedByUserId      String
  revokedByUserId      String?
  grantedAt            DateTime                      @default(now())
  revokedAt            DateTime?

  practiceStaff        PracticeStaff                 @relation(fields: [practiceStaffId], references: [id], onDelete: Cascade)
  practiceLocation     PracticeLocation              @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)
  grantedByUser        User                          @relation("PracticeStaffCapabilityGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  revokedByUser        User?                         @relation("PracticeStaffCapabilityRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@index([practiceLocationId, capabilityType, status])
  @@index([practiceStaffId, capabilityType, status])
}

model ClinicDay {
  id                        String                          @id @default(uuid())
  practiceLocationId        String
  serviceDate               DateTime
  status                    ClinicDayStatus                 @default(NOT_STARTED)
  openedAt                  DateTime?
  startedAt                 DateTime?
  delayedAt                 DateTime?
  closedAt                  DateTime?
  cancelledAt               DateTime?
  cancelledByUserId         String?
  cancellationReason        ClinicDayCancellationReason?
  cancellationNote          String?
  operatingPracticeStaffId  String?
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt

  practiceLocation          PracticeLocation                @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)
  operatingPracticeStaff    PracticeStaff?                  @relation("ClinicDayOperatingPracticeStaff", fields: [operatingPracticeStaffId], references: [id], onDelete: Restrict)
  cancelledByUser           User?                           @relation("ClinicDayCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  operatingStaffChanges     ClinicDayOperatingStaffChange[]
  administrativeScopes      AdministrativeAccountActionScope[]

  @@unique([practiceLocationId, serviceDate])
  @@index([serviceDate, status])
}

model ClinicDayOperatingStaffChange {
  id                         String                          @id @default(uuid())
  clinicDayId                String
  changeType                 ClinicDayOperatingStaffChangeType
  previousPracticeStaffId    String?
  newPracticeStaffId         String?
  actorUserId                String
  createdAt                  DateTime                        @default(now())

  clinicDay                   ClinicDay                       @relation(fields: [clinicDayId], references: [id], onDelete: Cascade)
  previousPracticeStaff       PracticeStaff?                  @relation("ClinicDayOperatingStaffChangePrevious", fields: [previousPracticeStaffId], references: [id], onDelete: Restrict)
  newPracticeStaff            PracticeStaff?                  @relation("ClinicDayOperatingStaffChangeNew", fields: [newPracticeStaffId], references: [id], onDelete: Restrict)
  actorUser                   User                            @relation("ClinicDayOperatingStaffChangeActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([clinicDayId, createdAt])
}

model QueueCounter {
  id                 String   @id @default(uuid())
  practiceLocationId String   @unique
  nextQueueNumber    Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  practiceLocation   PracticeLocation @relation(fields: [practiceLocationId], references: [id], onDelete: Cascade)
}

model Appointment {
  id                           String                     @id @default(uuid())
  bookingReference             String                     @unique
  practiceLocationId           String
  serviceDate                  DateTime
  bookingGroupId               String?
  queueNumber                  Int
  servingOrderKey              Decimal?
  waitingPlacementType         WaitingPlacementType?
  status                       AppointmentStatus          @default(WAITING)
  calledAt                     DateTime?
  completedAt                  DateTime?
  terminalAt                   DateTime?
  cancelledAt                  DateTime?
  cancelledByType              AppointmentCancelledByType?
  cancellationReason           String?
  selfServiceReinsertedAt      DateTime?
  activeAppointmentKey         String?
  firstName                    String
  lastName                     String
  mobileNumberEncrypted        String?
  mobileNumberHash             String?
  mobileNumberLastFour         String?
  bookedServiceName            String?
  bookedServicePrice           Decimal?
  estimatedServiceMinutes      Int
  anonymizedAt                 DateTime?
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt

  practiceLocation             PracticeLocation            @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)
  bookingGroup                 BookingGroup?                @relation(fields: [bookingGroupId], references: [id], onDelete: Restrict)
  answers                      BookingAnswer[]
  bookingAccessTokens          BookingAccessToken[]
  contactPreference            ContactPreference?
  scheduledReminders           ScheduledReminder[]
  notificationOutbox           NotificationOutbox[]
  queueEventLinks              QueueEventAppointmentLink[]
  commandIdempotencies         CommandIdempotency[]         @relation("CommandAppointment")
  commandResults               CommandIdempotency[]         @relation("CommandResultAppointment")

  @@unique([practiceLocationId, serviceDate, queueNumber])
  @@index([practiceLocationId, serviceDate, status])
  @@index([practiceLocationId, serviceDate, servingOrderKey])
  @@index([bookingGroupId])
  @@index([activeAppointmentKey])
}

model BookingGroup {
  id                         String                    @id @default(uuid())
  practiceLocationId         String
  serviceDate                DateTime
  servingProtectionEndedAt   DateTime?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  practiceLocation           PracticeLocation          @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)
  appointments               Appointment[]
  accessTokens               BookingGroupAccessToken[]
  recoveryAttempts           BookingGroupRecoveryAttempt[]
  notificationOutbox         NotificationOutbox[]
  commandIdempotencies       CommandIdempotency[]       @relation("CommandBookingGroup")
  commandResults             CommandIdempotency[]       @relation("CommandResultBookingGroup")

  @@index([practiceLocationId, serviceDate])
}

model BookingDraft {
  id                      String      @id @default(uuid())
  practiceLocationId      String
  controlTokenHash        String?     @unique
  mode                    String
  firstName               String?
  lastName                String?
  mobileNumber            String?
  serviceDate             DateTime?
  estimatedServiceMinutes Int?
  expiresAt               DateTime?
  acknowledgedAt          DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  practiceLocation        PracticeLocation @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)
  members                 BookingDraftMember[]
  answers                 BookingDraftAnswer[]
  commandIdempotencies    CommandIdempotency[]

  @@index([practiceLocationId])
}

model BookingDraftMember {
  id                      String   @id @default(uuid())
  bookingDraftId          String
  firstName               String
  lastName                String
  estimatedServiceMinutes Int
  createdAt               DateTime @default(now())

  bookingDraft            BookingDraft @relation(fields: [bookingDraftId], references: [id], onDelete: Cascade)

  @@index([bookingDraftId])
}

model BookingDraftAnswer {
  id              String   @id @default(uuid())
  bookingDraftId  String
  bookingQuestionId String
  answerValue     Json
  createdAt       DateTime @default(now())

  bookingDraft    BookingDraft    @relation(fields: [bookingDraftId], references: [id], onDelete: Cascade)
  bookingQuestion BookingQuestion @relation(fields: [bookingQuestionId], references: [id], onDelete: Restrict)

  @@unique([bookingDraftId, bookingQuestionId])
}

model BookingQuestion {
  id                      String   @id @default(uuid())
  practiceLocationId      String
  questionText            String
  questionType            String
  isRequired              Boolean  @default(false)
  isActive                Boolean  @default(true)
  displayOrder            Int
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  practiceLocation        PracticeLocation @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)
  answers                 BookingAnswer[]
  draftAnswers            BookingDraftAnswer[]

  @@index([practiceLocationId, isActive, displayOrder])
}

model BookingAnswer {
  id                String   @id @default(uuid())
  appointmentId     String
  bookingQuestionId String
  answerValue       Json
  createdAt         DateTime @default(now())

  appointment       Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  bookingQuestion   BookingQuestion @relation(fields: [bookingQuestionId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, bookingQuestionId])
}

model PracticeLocationService {
  id                 String                    @id @default(uuid())
  practiceLocationId String
  name               String
  price              Decimal?
  status             ServiceAvailabilityStatus @default(ACTIVE)
  displayOrder       Int
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  practiceLocation   PracticeLocation          @relation(fields: [practiceLocationId], references: [id], onDelete: Cascade)

  @@index([practiceLocationId, status, displayOrder])
}

model PracticeLocationScheduleRule {
  id                 String   @id @default(uuid())
  practiceLocationId String
  weekday            Weekday
  startTime          String
  endTime            String
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  practiceLocation   PracticeLocation @relation(fields: [practiceLocationId], references: [id], onDelete: Cascade)

  @@index([practiceLocationId, weekday, isActive])
}

model PracticeLocationScheduleException {
  id                 String   @id @default(uuid())
  practiceLocationId String
  serviceDate        DateTime
  isClosed           Boolean  @default(false)
  startTime          String?
  endTime            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  practiceLocation   PracticeLocation @relation(fields: [practiceLocationId], references: [id], onDelete: Cascade)

  @@unique([practiceLocationId, serviceDate])
}

model BookingAccessToken {
  id             String                    @id @default(uuid())
  appointmentId  String
  tokenHash      String                    @unique
  purpose        BookingAccessTokenPurpose
  expiresAt      DateTime
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime                  @default(now())

  appointment    Appointment               @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, purpose])
}

model BookingGroupAccessToken {
  id             String                         @id @default(uuid())
  bookingGroupId String
  tokenHash      String                         @unique
  purpose        BookingGroupAccessTokenPurpose
  expiresAt      DateTime
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime                       @default(now())

  bookingGroup   BookingGroup                   @relation(fields: [bookingGroupId], references: [id], onDelete: Cascade)
  commandResults CommandIdempotency[]            @relation("CommandResultBookingGroupAccessToken")

  @@index([bookingGroupId, purpose])
}

model BookingRecoveryAttempt {
  id                      String                        @id @default(uuid())
  appointmentId           String?
  mobileNumberHash        String
  practiceLocationId      String
  status                  BookingRecoveryAttemptStatus
  candidateConfirmedAt    DateTime?
  expiresAt               DateTime
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt

  commandIdempotencies    CommandIdempotency[]
}

model BookingGroupRecoveryAttempt {
  id                      String                            @id @default(uuid())
  bookingGroupId          String?
  mobileNumberHash        String
  practiceLocationId      String
  status                  BookingGroupRecoveryAttemptStatus
  expiresAt               DateTime
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt

  bookingGroup            BookingGroup?                     @relation(fields: [bookingGroupId], references: [id], onDelete: SetNull)
  commandIdempotencies    CommandIdempotency[]
}

model OtpVerification {
  id                      String    @id @default(uuid())
  purpose                 OtpPurpose
  mobileNumberHash        String
  codeHash                String
  expiresAt               DateTime
  consumedAt              DateTime?
  createdAt               DateTime  @default(now())

  @@index([purpose, mobileNumberHash, expiresAt])
}

model EmailVerification {
  id             String                  @id @default(uuid())
  userId         String
  tokenHash      String                  @unique
  status         EmailVerificationStatus @default(PENDING)
  expiresAt      DateTime
  verifiedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime                @default(now())

  @@index([userId, status])
}

model PasswordReset {
  id             String              @id @default(uuid())
  userId         String
  tokenHash      String              @unique
  status         PasswordResetStatus @default(PENDING)
  expiresAt      DateTime
  consumedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime            @default(now())

  @@index([userId, status])
}

model ContactPreference {
  id                       String   @id @default(uuid())
  appointmentId            String   @unique
  allowOperationalMessages Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  appointment              Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model ScheduledReminder {
  id                       String                           @id @default(uuid())
  practiceLocationId       String
  appointmentId            String?
  recipientSource          ScheduledReminderRecipientSource
  recipientMobileEncrypted String?
  messageBodyEncrypted     String
  scheduledFor             DateTime
  status                   ScheduledReminderStatus         @default(SCHEDULED)
  cancelledAt              DateTime?
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt

  practiceLocation         PracticeLocation                @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)
  appointment              Appointment?                    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([practiceLocationId, scheduledFor, status])
}

model NotificationOutbox {
  id                             String                    @id @default(uuid())
  deliveryIdentityKey            String                    @unique
  notificationType               NotificationType
  channel                        NotificationChannel
  status                         NotificationOutboxStatus   @default(PENDING)
  practiceLocationId             String?
  appointmentId                  String?
  bookingGroupId                 String?
  administrativeAccountActionId  String?
  recipientMobileEncrypted       String?
  recipientEmailEncrypted        String?
  messageBodyEncrypted           String
  providerIdempotencyKey         String                    @unique
  attemptCount                   Int                       @default(0)
  nextAttemptAt                  DateTime?
  expiresAt                      DateTime?
  createdAt                      DateTime                  @default(now())
  updatedAt                      DateTime                  @updatedAt

  practiceLocation               PracticeLocation?        @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)
  appointment                    Appointment?              @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  bookingGroup                   BookingGroup?             @relation(fields: [bookingGroupId], references: [id], onDelete: SetNull)
  administrativeAccountAction    AdministrativeAccountAction? @relation(fields: [administrativeAccountActionId], references: [id], onDelete: SetNull)
  logs                           NotificationLog[]

  @@index([status, nextAttemptAt])
  @@index([practiceLocationId, notificationType])
}

model NotificationLog {
  id                   String                     @id @default(uuid())
  notificationOutboxId String?
  notificationType     NotificationType
  channel              NotificationChannel
  outcome              NotificationAttemptOutcome
  practiceLocationId   String?
  actorUserId           String?
  providerMessageId     String?
  attemptedAt           DateTime
  createdAt             DateTime                   @default(now())

  notificationOutbox   NotificationOutbox?        @relation(fields: [notificationOutboxId], references: [id], onDelete: SetNull)
  practiceLocation     PracticeLocation?          @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)
  actorUser             User?                     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([notificationOutboxId])
  @@index([practiceLocationId, attemptedAt])
}

model QueueEvent {
  id                                    String                       @id @default(uuid())
  practiceLocationId                    String
  serviceDate                           DateTime
  queueEventSequence                    BigInt
  type                                  QueueEventType
  actorType                             QueueEventActorType
  actorUserId                           String?
  previousPrimaryStatus                 AppointmentStatus?
  newPrimaryStatus                      AppointmentStatus?
  previousSecondaryStatus               AppointmentStatus?
  newSecondaryStatus                    AppointmentStatus?
  previousPrimaryOrderKey               Decimal?
  newPrimaryOrderKey                    Decimal?
  previousSecondaryOrderKey             Decimal?
  newSecondaryOrderKey                  Decimal?
  previousPrimaryWaitingPlacementType   WaitingPlacementType?
  newPrimaryWaitingPlacementType        WaitingPlacementType?
  previousSecondaryWaitingPlacementType WaitingPlacementType?
  newSecondaryWaitingPlacementType      WaitingPlacementType?
  previousPrimaryTerminalAt             DateTime?
  newPrimaryTerminalAt                  DateTime?
  previousSecondaryTerminalAt           DateTime?
  newSecondaryTerminalAt                DateTime?
  reversesQueueEventId                  String?                      @unique
  metadata                              Json?
  createdAt                             DateTime                     @default(now())

  practiceLocation                      PracticeLocation             @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)
  actorUser                             User?                        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  reversesQueueEvent                    QueueEvent?                  @relation("QueueEventReversal", fields: [reversesQueueEventId], references: [id], onDelete: Restrict)
  reversedByQueueEvent                  QueueEvent?                  @relation("QueueEventReversal")
  appointmentLinks                      QueueEventAppointmentLink[]
  commandResults                        CommandIdempotency[]

  @@unique([practiceLocationId, serviceDate, queueEventSequence])
  @@index([practiceLocationId, serviceDate, type])
}

model QueueEventAppointmentLink {
  id             String                        @id @default(uuid())
  queueEventId   String
  appointmentId  String
  role           QueueEventAppointmentLinkRole
  createdAt      DateTime                      @default(now())

  queueEvent     QueueEvent                    @relation(fields: [queueEventId], references: [id], onDelete: Cascade)
  appointment    Appointment                   @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@unique([queueEventId, role])
  @@unique([queueEventId, appointmentId])
  @@index([appointmentId])
}

model CommandIdempotency {
  id                                  String                       @id @default(uuid())
  idempotencyKey                      String
  commandIdentityKey                  String                       @unique
  commandType                         CommandType
  requestFingerprint                  String
  practiceLocationId                  String?
  serviceDate                         DateTime?
  appointmentId                       String?
  bookingDraftId                      String?
  bookingRecoveryAttemptId            String?
  accountUserId                       String?
  bookingGroupId                      String?
  bookingGroupRecoveryAttemptId       String?
  doctorFinancialAccountId            String?
  actorUserId                         String?
  resultAppointmentId                 String?
  resultQueueEventId                  String?
  resultBookingGroupId                String?
  resultBookingGroupAccessTokenId     String?
  resultAdministrativeAccountActionId String?
  completedAt                         DateTime
  expiresAt                           DateTime
  createdAt                           DateTime                      @default(now())

  practiceLocation                    PracticeLocation?            @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)
  appointment                         Appointment?                 @relation("CommandAppointment", fields: [appointmentId], references: [id], onDelete: Restrict)
  resultAppointment                   Appointment?                 @relation("CommandResultAppointment", fields: [resultAppointmentId], references: [id], onDelete: Restrict)
  bookingDraft                        BookingDraft?                @relation(fields: [bookingDraftId], references: [id], onDelete: Restrict)
  bookingRecoveryAttempt              BookingRecoveryAttempt?      @relation(fields: [bookingRecoveryAttemptId], references: [id], onDelete: Restrict)
  bookingGroup                        BookingGroup?                @relation("CommandBookingGroup", fields: [bookingGroupId], references: [id], onDelete: Restrict)
  bookingGroupRecoveryAttempt         BookingGroupRecoveryAttempt? @relation(fields: [bookingGroupRecoveryAttemptId], references: [id], onDelete: Restrict)
  resultBookingGroup                  BookingGroup?                @relation("CommandResultBookingGroup", fields: [resultBookingGroupId], references: [id], onDelete: Restrict)
  resultBookingGroupAccessToken       BookingGroupAccessToken?     @relation("CommandResultBookingGroupAccessToken", fields: [resultBookingGroupAccessTokenId], references: [id], onDelete: Restrict)
  doctorFinancialAccount              DoctorFinancialAccount?      @relation(fields: [doctorFinancialAccountId], references: [id], onDelete: Restrict)
  commandResultQueueEvent             QueueEvent?                  @relation(fields: [resultQueueEventId], references: [id], onDelete: Restrict)

  @@index([commandType, practiceLocationId, serviceDate])
  @@index([commandType, appointmentId])
  @@index([expiresAt])
}

model SecretaryInvitation {
  id                String                    @id @default(uuid())
  inviterUserId     String
  inviteeUserId     String?
  inviteeEmail      String
  tokenHash         String                    @unique
  status            SecretaryInvitationStatus @default(PENDING)
  expiresAt         DateTime
  acceptedAt        DateTime?
  revokedAt         DateTime?
  createdAt         DateTime                  @default(now())

  inviterUser       User                      @relation("SecretaryInvitationInviter", fields: [inviterUserId], references: [id], onDelete: Restrict)
  inviteeUser       User?                     @relation("SecretaryInvitationInvitee", fields: [inviteeUserId], references: [id], onDelete: Restrict)

  @@index([inviteeEmail, status])
}

model AdministrativeAccountAction {
  id              String                              @id @default(uuid())
  actionType      AdministrativeAccountActionType
  status          AdministrativeAccountActionStatus   @default(COMPLETED)
  targetUserId    String
  actorUserId     String
  reason          SystemAdminActionReason
  note            String?
  createdAt       DateTime                            @default(now())

  targetUser      User                                @relation("AdministrativeAccountActionTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  actorUser       User                                @relation("AdministrativeAccountActionActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  scopes          AdministrativeAccountActionScope[]
  notificationOutbox NotificationOutbox[]
  commandResults  CommandIdempotency[]

  @@index([targetUserId, createdAt])
}

model AdministrativeAccountActionScope {
  id                              String                       @id @default(uuid())
  administrativeAccountActionId   String
  practiceLocationId              String?
  clinicDayId                     String?
  createdAt                       DateTime                     @default(now())

  administrativeAccountAction     AdministrativeAccountAction  @relation(fields: [administrativeAccountActionId], references: [id], onDelete: Cascade)
  practiceLocation                PracticeLocation?            @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)
  clinicDay                       ClinicDay?                   @relation(fields: [clinicDayId], references: [id], onDelete: Restrict)

  @@index([administrativeAccountActionId])
}

model SystemAdminAction {
  id             String                 @id @default(uuid())
  actionType     SystemAdminActionType
  targetUserId   String
  actorUserId    String
  reason         SystemAdminActionReason
  note           String?
  createdAt      DateTime               @default(now())

  targetUser     User                   @relation("SystemAdminActionTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  actorUser      User                   @relation("SystemAdminActionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([targetUserId, createdAt])
}

model SecretarySettingsDraft {
  id                 String                       @id @default(uuid())
  practiceLocationId String
  status             SecretarySettingsDraftStatus @default(DRAFT)
  submittedAt        DateTime?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  returnedAt         DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  practiceLocation   PracticeLocation             @relation(fields: [practiceLocationId], references: [id], onDelete: Cascade)
  services           SecretarySettingsDraftService[]
  scheduleRules      SecretarySettingsDraftSchedule[]
  exceptions         SecretarySettingsDraftException[]
  bookingQuestions   SecretarySettingsDraftBookingQuestion[]

  @@index([practiceLocationId, status])
}

model SecretarySettingsDraftService {
  id                       String                    @id @default(uuid())
  secretarySettingsDraftId String
  name                     String
  price                    Decimal?
  status                   ServiceAvailabilityStatus @default(ACTIVE)
  displayOrder             Int

  secretarySettingsDraft   SecretarySettingsDraft    @relation(fields: [secretarySettingsDraftId], references: [id], onDelete: Cascade)

  @@index([secretarySettingsDraftId])
}

model SecretarySettingsDraftSchedule {
  id                       String   @id @default(uuid())
  secretarySettingsDraftId String
  weekday                  Weekday
  startTime                String
  endTime                  String

  secretarySettingsDraft   SecretarySettingsDraft @relation(fields: [secretarySettingsDraftId], references: [id], onDelete: Cascade)

  @@index([secretarySettingsDraftId])
}

model SecretarySettingsDraftException {
  id                       String   @id @default(uuid())
  secretarySettingsDraftId String
  serviceDate              DateTime
  isClosed                 Boolean  @default(false)
  startTime                String?
  endTime                  String?

  secretarySettingsDraft   SecretarySettingsDraft @relation(fields: [secretarySettingsDraftId], references: [id], onDelete: Cascade)

  @@unique([secretarySettingsDraftId, serviceDate])
}

model SecretarySettingsDraftBookingQuestion {
  id                       String   @id @default(uuid())
  secretarySettingsDraftId String
  questionText             String
  questionType             String
  isRequired               Boolean  @default(false)
  isActive                 Boolean  @default(true)
  displayOrder             Int

  secretarySettingsDraft   SecretarySettingsDraft @relation(fields: [secretarySettingsDraftId], references: [id], onDelete: Cascade)

  @@index([secretarySettingsDraftId])
}

model DoctorFinancialAccount {
  id                       String                        @id @default(uuid())
  userId                   String                        @unique
  status                   DoctorFinancialAccountStatus
  currentPlanInterval      SubscriptionPlanInterval?
  trialStartedAt           DateTime?
  trialEndsAt              DateTime?
  currentPeriodStartsAt    DateTime?
  currentPeriodEndsAt      DateTime?
  graceEndsAt              DateTime?
  suspendedAt              DateTime?
  cancelledAt              DateTime?
  creditBalance            Decimal                       @default(0)
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt

  user                     User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  purchases                SubscriptionPurchase[]
  payments                 SubscriptionPayment[]
  creditLedger             SubscriptionCreditLedger[]
  refundRequests           RefundRequest[]
  financialAccessVerifications FinancialAccessVerification[]
  entitlementEvents        SubscriptionEntitlementEvent[]
  commandIdempotencies     CommandIdempotency[]
}

model SubscriptionPurchase {
  id                       String                     @id @default(uuid())
  doctorFinancialAccountId String
  planInterval             SubscriptionPlanInterval
  amount                   Decimal
  currency                 String
  status                   SubscriptionPurchaseStatus
  providerReference        String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  doctorFinancialAccount   DoctorFinancialAccount     @relation(fields: [doctorFinancialAccountId], references: [id], onDelete: Restrict)
  payments                 SubscriptionPayment[]
  refundRequests           RefundRequest[]

  @@index([doctorFinancialAccountId, createdAt])
}

model SubscriptionPayment {
  id                       String                    @id @default(uuid())
  doctorFinancialAccountId String
  subscriptionPurchaseId   String
  amount                   Decimal
  currency                 String
  status                   SubscriptionPaymentStatus
  providerReference        String?
  paidAt                   DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  doctorFinancialAccount   DoctorFinancialAccount    @relation(fields: [doctorFinancialAccountId], references: [id], onDelete: Restrict)
  subscriptionPurchase     SubscriptionPurchase      @relation(fields: [subscriptionPurchaseId], references: [id], onDelete: Restrict)
  refundRequests           RefundRequest[]

  @@index([doctorFinancialAccountId, createdAt])
  @@index([subscriptionPurchaseId])
}

model SubscriptionCreditLedger {
  id                       String                              @id @default(uuid())
  doctorFinancialAccountId String
  entryType                SubscriptionCreditLedgerEntryType
  amount                   Decimal
  reason                   String
  createdAt                DateTime                            @default(now())

  doctorFinancialAccount   DoctorFinancialAccount              @relation(fields: [doctorFinancialAccountId], references: [id], onDelete: Restrict)

  @@index([doctorFinancialAccountId, createdAt])
}

model RefundRequest {
  id                       String              @id @default(uuid())
  doctorFinancialAccountId String
  subscriptionPurchaseId   String
  subscriptionPaymentId    String?
  amount                   Decimal
  reason                   String
  status                   RefundRequestStatus
  processingNote           String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  doctorFinancialAccount   DoctorFinancialAccount @relation(fields: [doctorFinancialAccountId], references: [id], onDelete: Restrict)
  subscriptionPurchase     SubscriptionPurchase   @relation(fields: [subscriptionPurchaseId], references: [id], onDelete: Restrict)
  subscriptionPayment      SubscriptionPayment?   @relation(fields: [subscriptionPaymentId], references: [id], onDelete: Restrict)

  @@index([doctorFinancialAccountId, createdAt])
}

model FinancialAccessVerification {
  id                       String                           @id @default(uuid())
  doctorFinancialAccountId String
  tokenHash                String                           @unique
  status                   FinancialAccessVerificationStatus @default(PENDING)
  expiresAt                DateTime
  verifiedAt               DateTime?
  revokedAt                DateTime?
  createdAt                DateTime                         @default(now())

  doctorFinancialAccount   DoctorFinancialAccount           @relation(fields: [doctorFinancialAccountId], references: [id], onDelete: Restrict)

  @@index([doctorFinancialAccountId, status])
}

model SubscriptionEntitlementEvent {
  id                       String                           @id @default(uuid())
  doctorFinancialAccountId String
  eventType                SubscriptionEntitlementEventType
  effectiveAt              DateTime
  metadata                 Json?
  createdAt                DateTime                         @default(now())

  doctorFinancialAccount   DoctorFinancialAccount           @relation(fields: [doctorFinancialAccountId], references: [id], onDelete: Restrict)

  @@index([doctorFinancialAccountId, effectiveAt])
}
