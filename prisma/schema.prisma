model Appointment {
  id               String @id @default(uuid())
  bookingReference String @unique @db.VarChar(64)

  practiceLocationId String
  bookingGroupId     String?

  serviceDate             DateTime @db.Date
  estimatedServiceMinutes Int
  queueNumber             Int

  status AppointmentStatus @default(WAITING)

  servingOrderKey      Decimal?              @db.Decimal(38, 18)
  waitingPlacementType WaitingPlacementType?

  firstName  String? @db.VarChar(100)
  middleName String? @db.VarChar(100)
  lastName   String? @db.VarChar(100)
  suffix     String? @db.VarChar(30)

  existingPatientResponse ExistingPatientResponse?

  mobileNumberEncrypted String?
  mobileNumberHash      String?
  mobileNumberLastFour  String? @db.VarChar(4)

  calledAt     DateTime? @db.Timestamptz(3)
  completedAt  DateTime? @db.Timestamptz(3)
  cancelledAt  DateTime? @db.Timestamptz(3)
  terminalAt   DateTime? @db.Timestamptz(3)
  anonymizedAt DateTime? @db.Timestamptz(3)

  cancelledByType    AppointmentCancelledByType?
  cancellationReason String?                     @db.VarChar(255)

  createdByUserId String?

  selfServiceReinsertedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  practiceLocation PracticeLocation @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)
  bookingGroup     BookingGroup?    @relation(fields: [bookingGroupId], references: [id], onDelete: Restrict)
  createdByUser    User?            @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  bookingAccessTokens     BookingAccessToken[]
  bookingRecoveryAttempts BookingRecoveryAttempt[]    @relation("BookingRecoveryCandidateAppointment")
  contactPreference       ContactPreference?
  followUpRecommendations FollowUpRecommendation[]
  notificationLogs        NotificationLog[]
  queueEventLinks         QueueEventAppointmentLink[]
  appointmentAnswers      AppointmentAnswer[]
  bookedServices          AppointmentBookedService[]

  @@unique([practiceLocationId, serviceDate, queueNumber])
  @@index([practiceLocationId, serviceDate])
  @@index([practiceLocationId, status, serviceDate])
  @@index([practiceLocationId, serviceDate, servingOrderKey])
  @@index([bookingGroupId])
  @@index([mobileNumberHash, practiceLocationId, serviceDate, status])
  @@index([createdByUserId, createdAt])
  @@index([status, terminalAt])
}

model OtpVerification {
  id String @id @default(uuid())

  bookingDraftId String
  bookingDraft   BookingDraft @relation(fields: [bookingDraftId], references: [id], onDelete: Restrict)

  mobileNumberHash String     @db.VarChar(128)
  otpHash          String     @db.VarChar(255)
  purpose          OtpPurpose

  expiresAt DateTime @db.Timestamptz(3)

  attemptCount Int @default(0)
  maxAttempts  Int @default(5)

  verifiedAt    DateTime? @db.Timestamptz(3)
  consumedAt    DateTime? @db.Timestamptz(3)
  invalidatedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([bookingDraftId])
  @@index([mobileNumberHash, purpose, expiresAt])
  @@index([expiresAt])
}

model BookingAccessToken {
  id String @id @default(uuid())

  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  // Required when the credential is created/usable. Nullable only so approved
  // security/privacy cleanup can destroy credential material without retaining
  // a patient-correlating secret indefinitely.
  tokenHash String? @unique @db.VarChar(255)

  purpose BookingAccessTokenPurpose @default(VIEW_AND_MANAGE_BOOKING)

  expiresAt DateTime @db.Timestamptz(3)

  lastUsedAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([appointmentId])
  @@index([expiresAt])
  @@index([appointmentId, revokedAt, expiresAt], map: "BookingAccessToken_active_lookup_idx")
}

model BookingRecoveryAttempt {
  id String @id @default(uuid())

  practiceLocationId String
  serviceDate        DateTime @db.Date

  mobileNumberEncrypted String?
  mobileNumberHash      String? @db.VarChar(64)
  mobileHashKeyVersion  Int?
  mobileNumberLastFour  String? @db.VarChar(4)

  status BookingRecoveryAttemptStatus @default(PENDING_OTP)

  candidateAppointmentId String?

  verifiedAt           DateTime? @db.Timestamptz(3)
  candidateConfirmedAt DateTime? @db.Timestamptz(3)
  completedAt          DateTime? @db.Timestamptz(3)
  rejectedAt           DateTime? @db.Timestamptz(3)
  cancelledAt          DateTime? @db.Timestamptz(3)
  expiredAt            DateTime? @db.Timestamptz(3)

  expiresAt DateTime @db.Timestamptz(3)

  protectedDataClearedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  practiceLocation PracticeLocation @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)

