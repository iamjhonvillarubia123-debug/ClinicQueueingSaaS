  bookingDraftMember      BookingDraftMember?     @relation(fields: [bookingDraftMemberId, bookingDraftId], references: [id, bookingDraftId], onDelete: Restrict)
  practiceLocationService PracticeLocationService @relation(fields: [practiceLocationServiceId], references: [id], onDelete: Restrict)
  @@index([bookingDraftId])
  @@index([bookingDraftMemberId])
  @@index([practiceLocationServiceId])
}

model ClinicDay {
  id String @id @default(uuid())
  practiceLocationId String
  serviceDate        DateTime @db.Date
  status ClinicDayStatus @default(NOT_STARTED)
  openingOverrideAt           DateTime? @db.Timestamptz(3)
