  authoredSettingsDrafts SecretarySettingsDraft[] @relation("SecretarySettingsDraftAuthor")
  operatingClinicDays ClinicDay[] @relation("ClinicDayOperatingPracticeStaff")
  operatingStaffAuditPrevious ClinicDayOperatingStaffAudit[] @relation("ClinicDayOperatingStaffAuditPrevious")
  operatingStaffAuditNew ClinicDayOperatingStaffAudit[] @relation("ClinicDayOperatingStaffAuditNew")

  @@unique([userId, practiceLocationId])
}

