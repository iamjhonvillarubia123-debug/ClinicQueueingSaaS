model BookingDraft {
  id               String             @id @default(uuid())
  bookingReference String?            @unique @db.VarChar(20)
  mode             BookingDraftMode   @default(INDIVIDUAL)
  status           BookingDraftStatus @default(PENDING_OTP)
  practiceLocationId String
  existingPatientResponse ExistingPatientResponse?
  firstName  String? @db.VarChar(100)
  middleName String? @db.VarChar(100)
  lastName   String? @db.VarChar(100)
  suffix     String? @db.VarChar(20)
  mobileNumberEncrypted String?
  mobileNumberHash      String? @db.VarChar(128)
  mobileNumberLastFour  String? @db.Char(4)
  activeDraftKey String? @unique @db.VarChar(64)
  draftControlTokenHash String? @db.VarChar(64)
  privacyNoticeAcknowledgedAt DateTime? @db.Timestamptz(3)
  privacyNoticeVersion        String?   @db.VarChar(50)
  scheduledReminderOptIn      Boolean   @default(false)
  serviceDate DateTime @db.Date
  estimatedServiceMinutes Int?
  expiresAt              DateTime  @db.Timestamptz(3)
  consumedAt             DateTime? @db.Timestamptz(3)
  cancelledAt            DateTime? @db.Timestamptz(3)
  expiredAt              DateTime? @db.Timestamptz(3)
  protectedDataClearedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  practiceLocation PracticeLocation @relation(fields: [practiceLocationId], references: [id], onDelete: Restrict)
  otpVerifications    OtpVerification[]
  bookingDraftMembers BookingDraftMember[]
  bookingDraftAnswers BookingDraftAnswer[]
  serviceSelections   BookingDraftServiceSelection[]
  @@index([practiceLocationId, serviceDate])
  @@index([mobileNumberHash, practiceLocationId, serviceDate, status])
  @@index([mode, status, expiresAt])
  @@index([status, expiresAt])
  @@index([status, protectedDataClearedAt, consumedAt, expiredAt, cancelledAt], map: "BookingDraft_terminal_cleanup_idx")
}

model BookingDraftMember {
  id String @id @default(uuid())
  bookingDraftId String
  memberOrder    Int
  firstName  String? @db.VarChar(100)
  middleName String? @db.VarChar(100)
  lastName   String? @db.VarChar(100)
  suffix     String? @db.VarChar(20)
  existingPatientResponse ExistingPatientResponse?
  estimatedServiceMinutes Int?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  bookingDraft BookingDraft @relation(fields: [bookingDraftId], references: [id], onDelete: Restrict)
  answers           BookingDraftAnswer[]
  serviceSelections BookingDraftServiceSelection[]
  @@unique([bookingDraftId, memberOrder])
  @@unique([id, bookingDraftId])
  @@index([bookingDraftId])
}

model BookingDraftServiceSelection {
  id String @id @default(uuid())
  bookingDraftId            String
  bookingDraftMemberId      String?
  practiceLocationServiceId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
