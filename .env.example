# Development example only. Never commit real secrets.
DATABASE_URL=postgresql://clinic_queue_dev:CHANGE_ME@localhost:5432/clinic_queue_dev?schema=public
SHADOW_DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_PASSWORD@localhost:5432/clinic_queueing_saas_shadow?schema=public"
TEST_DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_PASSWORD@localhost:5432/clinic_queueing_saas_test?schema=public"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
MOBILE_ENCRYPTION_KEY_V1=REPLACE_WITH_BASE64_32_BYTE_KEY
MOBILE_LOOKUP_HMAC_KEY_V1=REPLACE_WITH_BASE64_32_BYTE_KEY
MOBILE_ENCRYPTION_ACTIVE_KEY_ID=v1
MOBILE_LOOKUP_ACTIVE_KEY_ID=v1
OTP_HMAC_KEY_V1=REPLACE_WITH_BASE64_32_BYTE_KEY
OTP_HMAC_ACTIVE_KEY_ID=v1
PORT=3000
PUBLIC_APP_BASE_URL=http://localhost:3000

# Doctor email-verification issuance limits. Initial issuance counts toward these windows.
EMAIL_VERIFICATION_MAX_ISSUANCES_PER_15_MINUTES=3
EMAIL_VERIFICATION_MAX_ISSUANCES_PER_24_HOURS=10
